# LLM & Embedding Providers
# Provide at least one API key depending on your preferred provider:
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
DEFAULT_LLM_PROVIDER=openai  # options: openai, gemini
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Vector DB Settings
VECTOR_STORE_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=financial_reports

# Retrieval & Reranker Settings
TOP_K_RETRIEVAL=10
TOP_K_RERANK=4
RERANKER_MODEL=flashrank # options: flashrank, bge, none

# App & Server Settings
API_HOST=0.0.0.0
API_PORT=8000
